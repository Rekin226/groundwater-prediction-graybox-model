# -----------------------------
# Project-specific (DO NOT COMMIT)
# -----------------------------
# Environment variables (API keys, secrets)
.env
.env.local

# Keep directories but ignore all contents
/data/*
!/data/.gitkeep
/docs/*

# Ignore workspace contents but keep the folder structure visible via .gitkeep.
# Git needs parent directories un-ignored too, hence the "!/workspace/**/" line.
/workspace/**
!/workspace/**/
!/workspace/**/.gitkeep

# Scratch / experimental runs — not for commit
/test_neg_val/

# CONTAINS PLAINTEXT WRA API CREDENTIALS — must never be committed.
# Move the username/password to .env and read them via os.getenv before
# this file is added to version control.
/subsidence/data_fetch_api/

# Node tooling pulled in by MCP servers — unrelated to the analysis, 117 MB,
# and includes platform-specific compiled binaries.
/node_modules/
/package.json
/package-lock.json

# Slide-deck build artifacts (regenerated by outputs_build/build_deck.js)
/outputs_build/

# Derived subsidence data outputs (fetched / computed at runtime, not for commit)
/subsidence/data/sub_station_master.csv
/subsidence/data/sub_pairing.csv
/subsidence/data/h_drivers/

/.github/

# -----------------------------
# Python
# -----------------------------
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
ENV/
env/

# Packaging / build
build/
dist/
*.egg-info/
.eggs/

# Testing / coverage
.pytest_cache/
.coverage
coverage.xml
htmlcov/
.tox/
.nox/

# Type checking
.mypy_cache/
.pyre/
.pytype/

# Jupyter / notebooks
.ipynb_checkpoints/

# IDEs / editors
.vscode/
.idea/
*.swp

# OS files
.DS_Store
Thumbs.db

# Logs
*.log

# -----------------------------
# Geo / data formats (often large / derived)
# -----------------------------
*.tif
*.tiff
*.grd
*.asc
*.nc
*.h5
*.hdf5
*.parquet
*.feather

# QC outputs from cleaning module (regenerated by 03b_clean_ls.py)
/subsidence/data/qc_*.csv

# pptx build tmpdir (recreated by build_lab_pptx.py)
/subsidence/scripts/_pptx_tmp/

# Test-run artifacts (recreated by subsidence/tests/* on every pytest invocation)
/workspace/results_sub/_*/
.gstack/
