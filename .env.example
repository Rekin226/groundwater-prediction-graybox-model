# Perplexity API Configuration (Example)
# Copy this file to .env and add your actual API key
# Get your key from: https://www.perplexity.ai/settings/api

PERPLEXITY_API_KEY=pplx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: Specify preferred Perplexity model (sonar, sonar-pro)
PERPLEXITY_MODEL=sonar-pro
